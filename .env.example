# Copy this file to .env and fill in your values.

# The WhatsApp group's JID (e.g. 120363012345678901@g.us).
# Get this by running `npm run start` once, sending any message in the
# group, and reading it from the console log ("Discovered group JID: ...").
GROUP_JID=

# Optional: a personal number (in JID form, e.g. 233241234567@s.whatsapp.net)
# that idle-member reports get DMed to instead of posted in the group.
# Leave blank to post idle reports directly in the group.
REPORT_TO_JID=

# Phone number (with country code, digits only, e.g. 233241234567) for the
# bot's dedicated WhatsApp account. Only needed for pairing-code login.
BOT_PHONE_NUMBER=

# IANA timezone used for all schedules.
TIMEZONE=Africa/Accra

# Airtable base that holds the Titles, ActivityPrompts, and Birthdays
# tables. See README.md for the exact schema to set up.
# Personal access token: Airtable -> account icon -> Developer Hub ->
# Personal access tokens -> Create token, scoped to this base with the
# data.records:read scope.
AIRTABLE_TOKEN=
# Base ID looks like "appXXXXXXXXXXXXXX" -- found in the base's API
# documentation page (Help -> API documentation) or in its URL.
AIRTABLE_BASE_ID=
